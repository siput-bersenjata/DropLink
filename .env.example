# Cloudflare R2 Credentials (Storage 10GB Gratis, 0 Biaya Egress)
# Dapatkan dari Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=drop-link-storage
# Opsional: Custom domain atau r2.dev domain untuk download langsung
R2_PUBLIC_DOMAIN=

# Cloudflare Turnstile Captcha (Anti-Bot Pintar)
# Dapatkan dari Cloudflare Dashboard -> Turnstile -> Add Site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Keamanan Vercel Cron Cleanup (Pembersihan File Kadaluarsa Harian)
CRON_SECRET=your_random_secret_token_here
